{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Swedish Influenza Forecast Hub model metadata",
  "description": "Schema for one participating forecast model.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "model_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_+]+-[A-Za-z0-9_+]+$"
    },
    "team_name": {"type": "string", "minLength": 1},
    "team_abbr": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_+]+$",
      "maxLength": 16
    },
    "model_name": {"type": "string", "minLength": 1},
    "model_abbr": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_+]+$",
      "maxLength": 16
    },
    "model_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "model_contributors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "affiliation": {"type": "string", "minLength": 1},
          "orcid": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{4}-\\d{4}-[\\dX]{4}$"
          }
        },
        "required": ["name", "affiliation"]
      }
    },
    "methods": {"type": "string", "minLength": 1},
    "method_category": {"type": "string", "minLength": 1},
    "data_sources": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "software": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "code_repository": {"type": ["string", "null"]},
    "code_license": {"type": ["string", "null"]},
    "license": {"const": "CC-BY-4.0"},
    "designated_model": {"type": "boolean"}
  },
  "required": [
    "model_id",
    "team_name",
    "team_abbr",
    "model_name",
    "model_abbr",
    "model_version",
    "model_contributors",
    "methods",
    "method_category",
    "data_sources",
    "software",
    "license",
    "designated_model"
  ]
}
